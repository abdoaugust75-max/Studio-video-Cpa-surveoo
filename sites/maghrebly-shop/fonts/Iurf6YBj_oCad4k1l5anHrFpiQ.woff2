<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
(function(){
"use strict";
var sticky=document.getElementById('sticky');
function onScroll(){if(window.scrollY>220){sticky.classList.add('show');}else{sticky.classList.remove('show');}}
window.addEventListener('scroll',onScroll,{passive:true});
onScroll();

var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.1});
document.querySelectorAll('.rv').forEach(function(el){io.observe(el);});

var overlay=document.getElementById('verifyOverlay');
var modalA=document.getElementById('modalA'),modalB=document.getElementById('modalB');
var video=document.getElementById('tutVideo');
var nudged=false;

window.openVerify=function(el){
  modalA.style.display='block';modalB.style.display='none';
  overlay.classList.add('show');
  document.body.style.overflow='hidden';
  try{if(video){video.play().catch(function(){});}}catch(e){}
};
window.closeVerify=function(){
  overlay.classList.remove('show');
  document.body.style.overflow='';
  try{if(video){video.pause();}}catch(e){}
};
window.showPhaseB=function(){
  modalA.style.display='none';modalB.style.display='block';
  try{if(video){video.pause();}}catch(e){}
};
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeVerify();});

function nudge(){
  if(nudged)return;nudged=true;
  var shown=overlay.classList.contains('show');
  if(!shown){window.openVerify();}
}
document.addEventListener('visibilitychange',function(){if(document.visibilityState==='hidden'){setTimeout(nudge,400);}});
window.addEventListener('pagehide',nudge);
})();
</script>
<script>
(function(){
  try{
    if(window.__auroraDeepTrack)return;window.__auroraDeepTrack=true;
    var track=function(n,l){try{if(window.umami&&umami.track)umami.track(n,{label:l||""});}catch(e){}};
    var marks=[25,50,75,100],done={};
    var onScroll=function(){
      var h=document.documentElement.scrollHeight-window.innerHeight;
      var p=h>0?Math.round(window.scrollY/h*100):0;
      for(var i=0;i<marks.length;i++){if(p>=marks[i]&&!done[marks[i]]){done[marks[i]]=1;track("scroll-"+marks[i]);}}
    };
    window.addEventListener("scroll",onScroll,{passive:true});
    window.addEventListener("pagehide",function(){track("exit-page");});
    document.addEventListener("visibilitychange",function(){if(document.visibilityState==="hidden"){track("tab-hidden");}});
    var v=document.querySelector("#pageVideo");
    if(v){var vio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){track("video-visible");vio.disconnect();}});},{threshold:.3});vio.observe(v);}
  }catch(e){}
})();
</script>
</body>
</html>
